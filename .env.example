# 复制这个文件为 .env，然后按需修改。.env 不要提交到 Git。

# ---------- 存储 ----------
# SQLite 数据库文件位置（相对项目根目录或绝对路径）
DOCUMIND_DB=data/documind.db

# ---------- 切块参数 ----------
# 每个文本块的最大字符数
DOCUMIND_CHUNK_SIZE=500
# 相邻块之间的重叠字符数，用于避免关键信息被切断
DOCUMIND_CHUNK_OVERLAP=80

# ---------- 检索参数 ----------
# 默认返回的检索结果条数
DOCUMIND_TOP_K=5
# 向量维度（HashingEmbedder 使用）
DOCUMIND_EMBED_DIM=256

# ---------- 上传限制 ----------
# 单个文件最大字节数，默认 5MB
DOCUMIND_MAX_UPLOAD=5242880

# ---------- 大模型（Week 2 才会用到） ----------
# 任何 OpenAI 兼容接口都能接。下面按 DeepSeek 填好了，换成通义/智谱/OpenAI 只改这三行。
# 注意：DeepSeek 的 key 形如 sk-xxxxxxxx，只能放在 .env 里，永远不要提交到 Git。
DOCUMIND_LLM_BASE_URL=https://api.deepseek.com/v1
DOCUMIND_LLM_API_KEY=
# 对话用 deepseek-chat；不要用 deepseek-reasoner 做 RAG 的问答环节（见 ROADMAP 说明）
DOCUMIND_LLM_MODEL=deepseek-chat
# 生成温度：RAG 场景要"照资料说"，温度调低更稳定
DOCUMIND_LLM_TEMPERATURE=0.1
# 单次回答的最大 token 数，控制成本
DOCUMIND_LLM_MAX_TOKENS=1024
